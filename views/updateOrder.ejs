<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><title>Update Order</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <h1>Update Order</h1>
  <form class="card" action="/orders/update/<%= order._id %>" method="POST">
    <% if (error) { %><p class="error"><%= error %></p><% } %>

    <label>Customer Name</label>
    <input type="text" name="customerName" value="<%= order.customerName %>" required>

    <label>Product Name</label>
    <input type="text" name="productName" list="products" value="<%= order.productName %>" required>
    <datalist id="products">
      <% products.forEach(p => { %><option value="<%= p.productName %>"><% }) %>
    </datalist>

    <label>Quantity</label>
    <input type="number" name="quantity" min="1" value="<%= order.quantity %>" required>

    <label>Order Date</label>
    <input type="date" name="orderDate"
           value="<%= new Date(order.orderDate).toISOString().slice(0, 10) %>" required>

    <button type="submit" class="btn btn-blue btn-block">Update Order</button>
    <a href="/orders" class="btn btn-orange btn-block">Go Back</a>
  </form>
</body>
</html>
