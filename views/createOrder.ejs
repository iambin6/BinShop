<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tạo đơn hàng mới - Bin Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Header / Navbar -->
  <header class="navbar">
    <div class="nav-brand">
      <span class="logo">🛒</span>
      <h2>Bin Shop Manager</h2>
    </div>
    <div class="nav-user">
      <% if (currentUser) { %>
        <span class="user-info">
          Xin chào, <strong><%= currentUser.fullName || currentUser.username %></strong>
        </span>
        <a href="/profile" class="btn btn-gray btn-sm">⚙️ Cài đặt</a>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
      <% } %>
    </div>
  </header>

  <main class="container">
    <div class="form-wrapper">
      <div class="form-header">
        <h1>➕ Tạo Đơn Hàng Mới</h1>
        <p>Nhập thông tin chi tiết đơn hàng khách đặt mua</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger">
          <span class="alert-icon">⚠</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="card form-card" action="/orders/create" method="POST">
        <div class="form-group">
          <label for="customerName">Tên Khách Hàng <span class="required">*</span></label>
          <input 
            type="text" 
            id="customerName" 
            name="customerName" 
            placeholder="Nhập họ và tên khách hàng"
            value="<%= (old && old.customerName) ? old.customerName : '' %>" 
            required 
            autofocus
          >
        </div>

        <div class="form-group">
          <label for="productName">Sản Phẩm <span class="required">*</span></label>
          <input 
            type="text" 
            id="productName" 
            name="productName" 
            list="products" 
            placeholder="Gõ hoặc chọn sản phẩm..."
            value="<%= (old && old.productName) ? old.productName : '' %>" 
            required
          >
          <datalist id="products">
            <% products.forEach(p => { %>
              <option value="<%= p.productName %>">
                <%= p.productName %> - <%= p.unitPrice.toLocaleString('vi-VN') %> VND (<%= p.category %>)
              </option>
            <% }) %>
          </datalist>
          <small class="form-hint">Gợi ý: Bấm đúp vào ô để xem danh sách sản phẩm có sẵn.</small>
        </div>

        <div class="form-group">
          <label for="quantity">Số Lượng Đặt Mua <span class="required">*</span></label>
          <input 
            type="number" 
            id="quantity" 
            name="quantity" 
            min="1" 
            placeholder="Nhập số lượng (tối thiểu 1)"
            value="<%= (old && old.quantity) ? old.quantity : '1' %>" 
            required
          >
        </div>

        <div class="form-group">
          <label for="orderDate">Ngày Đặt Hàng <span class="required">*</span></label>
          <input 
            type="date" 
            id="orderDate" 
            name="orderDate" 
            value="<%= (old && old.orderDate) ? old.orderDate : new Date().toISOString().slice(0, 10) %>" 
            required
          >
        </div>

        <div class="form-btn-group">
          <button type="submit" class="btn btn-blue btn-lg">Xác Nhận Đặt Hàng</button>
          <a href="/orders" class="btn btn-gray btn-lg">Quay Lại Danh Sách</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
