<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng ký tài khoản - Bin Shop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo">📝</div>
      <h1>Tạo tài khoản mới</h1>
      <p>Đăng ký tài khoản quản trị Bin Shop</p>
    </div>

    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <form action="/signup" method="POST">
      <div class="form-group">
        <label for="username">Tên đăng nhập (Username) *</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="Ví dụ: nguyenvana" 
          value="<%= (old && old.username) ? old.username : '' %>" 
          required 
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="email">Địa chỉ Email *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="Ví dụ: nguyenvana@gmail.com" 
          value="<%= (old && old.email) ? old.email : '' %>" 
          required
        >
      </div>

      <div class="form-group">
        <label for="fullName">Họ và tên</label>
        <input 
          type="text" 
          id="fullName" 
          name="fullName" 
          placeholder="Ví dụ: Nguyễn Văn A" 
          value="<%= (old && old.fullName) ? old.fullName : '' %>"
        >
      </div>

      <div class="form-group">
        <label for="password">Mật khẩu * (Tối thiểu 6 ký tự)</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Nhập mật khẩu" 
          required 
          minlength="6"
        >
      </div>

      <div class="form-group">
        <label for="confirmPassword">Xác nhận mật khẩu *</label>
        <input 
          type="password" 
          id="confirmPassword" 
          name="confirmPassword" 
          placeholder="Nhập lại mật khẩu" 
          required 
          minlength="6"
        >
      </div>

      <button type="submit" class="btn btn-blue btn-block">Đăng Ký</button>
    </form>

    <div class="auth-footer">
      <p>Đã có tài khoản? <a href="/login">Đăng nhập tại đây</a></p>
    </div>
  </div>
</body>
</html>
